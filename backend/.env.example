# Server configuration
PORT=
NODE_ENV=
# Local SQLite default. Production must supply its own persistent DATABASE_URL.
DATABASE_URL="file:./dev.db"

# Server-only secrets. Configure real values in VibeCode production environment settings.
OPENAI_API_KEY=
INSTALLATION_TOKEN_SECRET=

# Anonymous installation session settings
ACCESS_TOKEN_TTL_SECONDS=
REFRESH_CREDENTIAL_TTL_DAYS=

# AI safety limits
AI_REQUESTS_PER_10_MINUTES=
AI_DAILY_QUOTA=
AI_MONTHLY_QUOTA=
AI_GLOBAL_REQUESTS_PER_MINUTE=
REGISTRATION_REQUESTS_PER_HOUR=
REFRESH_REQUESTS_PER_HOUR=
MAX_CONTENT_REQUEST_BYTES=
IDEMPOTENCY_RETENTION_HOURS=

# Media safety limits (Launch 1B)
MEDIA_IMAGE_MAX_BYTES=
MEDIA_VIDEO_MAX_BYTES=
MEDIA_UPLOADS_PER_DAY=
MEDIA_UPLOADS_PER_10_MINUTES=
MEDIA_GLOBAL_UPLOADS_PER_MINUTE=
MEDIA_RETAINED_STORAGE_BYTES=
